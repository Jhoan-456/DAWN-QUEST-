config_version=5

[accessibility]

general/updates_per_second=100

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Dawn Quest"
config/version="BETA 0.0.1"
run/main_scene="uid://cqfhnpbre08iy"
config/features=PackedStringArray("4.5", "GL Compatibility")
run/max_fps=500
config/icon="uid://d080a6pv7e4j5"

[autoload]

